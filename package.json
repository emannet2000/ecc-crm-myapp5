{
  "name": "ecc-crm-verification",
  "private": true,
  "scripts": {
    "test": "node --test tests/dom.test.cjs tests/dashboard.test.cjs tests/administration-elm.test.cjs tests/mobile.test.cjs tests/workspace-interactions.test.cjs tests/usability-review.test.cjs tests/integration-acceptance.test.cjs",
    "test:live": "ECC_BROWSER_LIVE=true node --test tests/browser.test.cjs tests/journey.browser.cjs",
    "test:browser": "node --test tests/browser.test.cjs tests/journey.browser.cjs",
    "test:offline": "node --test tests/offline.browser.cjs",
    "test:integrations": "node tests/live-integrations.cjs",
    "test:consolidation": "node --test tests/consolidation.browser.cjs",
    "test:workflow": "node --test tests/workflow.browser.cjs",
    "test:performance": "cd golang-backend && go test -run '^$' -bench BenchmarkRepositoryWorkload -benchtime=3x -benchmem",
    "test:improvements": "node --test tests/improvements.browser.cjs",
    "test:workspace-next": "node --test tests/workspace-next.browser.cjs",
    "test:mobile-chat": "node --test tests/mobile-chat.browser.cjs",
    "test:reports": "node --test tests/reports.browser.cjs",
    "test:dashboard-live": "ECC_BROWSER_LIVE=true node --test --test-name-pattern=\"live dashboard filters\" tests/browser.test.cjs",
    "test:integrations:strict": "node tests/live-integrations.cjs --strict",
    "test:properties": "./scripts/test-properties.sh",
    "test:elm": "node tests/administration-elm.test.cjs",
    "test:coverage": "./scripts/test-coverage.sh",
    "test:administration": "node --test tests/administration.browser.cjs",
    "test:all": "./scripts/test-all.sh",
    "test:mobile": "node --test --test-concurrency=1 tests/mobile.test.cjs tests/mobile-chat.browser.cjs tests/improvements.browser.cjs tests/offline.browser.cjs"
  },
  "devDependencies": {
    "puppeteer": "25.10.0",
    "linkedom": "0.18.12"
  }
}
