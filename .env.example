# Set these in your process environment; the app does not auto-load this file.
PORT=7000
APP_URL=http://localhost:7000
DATABASE_PATH=data/crm.sqlite3
ALLOW_SIGNUP=true
# Demo records and the public demo login are opt-in. Keep false in production.
SEED_DEMO_DATA=false
# Optional stable secret. Otherwise data/auth-secret is generated with mode 0600.
JWT_SECRET=
COOKIE_SECURE=false
TRUSTED_PROXY_CIDRS=

# SMTP can also be configured by a workspace administrator in Workspace tools.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS_MODE=starttls

# Stripe Checkout and signed callback verification.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Organization sign-in. Users must already have an active CRM account.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# SAML SP-initiated sign-in; HTTPS required for cross-site tracking cookies.
SAML_METADATA_URL=
SAML_CERT_FILE=
SAML_KEY_FILE=
SAML_EMAIL_ATTRIBUTE=email

# Generate with: cd golang-backend && go run ./cmd/vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# AI: set a supported Responses model; then enable it in Workspace → Integrations.
OPENAI_API_KEY=
OPENAI_MODEL=

# Signed inbound email adapter. HMAC-SHA256(timestamp + '.' + raw JSON body).
INBOUND_EMAIL_SECRET=

# Microsoft Graph inbox delta sync. Configure one mailbox/workspace per process.
GRAPH_ORG_ID=
GRAPH_ACCESS_TOKEN=
# Optional delegated OAuth refresh instead of a manually renewed access token.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_REFRESH_TOKEN=

# WhatsApp Cloud API: configure the Meta account's supported Graph API version.
WHATSAPP_ORG_ID=
WHATSAPP_API_VERSION=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
